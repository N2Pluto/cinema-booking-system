# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpassword
MONGO_DB=cinema_booking

# Backend
MONGO_URI=mongodb://root:rootpassword@mongodb:27017/cinema_booking?authSource=admin

# Redis
REDIS_USERNAME=cinema_user
REDIS_PASSWORD=change-me-to-a-strong-password
REDIS_URL=redis://cinema_user:change-me-to-a-strong-password@redis:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Admin
# Comma-separated list of Google account emails that will be granted ADMIN role
ADMIN_EMAILS=admin@example.com

# Frontend
VITE_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
